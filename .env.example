# ─────────────────────────────────────────────
# ScamHawk 环境变量示例
# 复制本文件为 .env.local 并填入你自己的值：
#   cp .env.example .env.local
# 切勿把 .env.local 提交到 Git。
# ─────────────────────────────────────────────

# ── 数据库（Neon PostgreSQL）─────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/scamhawk?sslmode=require"

# ── Clerk 认证 ────────────────────────────────
# 在 https://dashboard.clerk.com 创建应用后获取
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxx"

# ── Paddle Billing ────────────────────────────
# 在 https://dashboard.paddle.com 获取（Sandbox 环境）
PADDLE_API_KEY="pdl_xxxxxxxxxxxx"          # 服务端 API Key
PADDLE_ENVIRONMENT="sandbox"               # sandbox 或 live
PADDLE_WEBHOOK_SECRET="pdl_ntf_xxxxxxxxxxxx"  # Webhook 签名密钥
PADDLE_PRICE_ID_PRO_MONTHLY="pri_xxxxxxxxxxxx" # 专业版月度价格 ID
# 客户端 Token（Developer Tools > Authentication > Client-side tokens，pdl_client_ 开头）
# 设计上允许暴露给前端，用于 Checkout Overlay
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="pdl_client_xxxxxxxxxxxx"

# ── Resend 邮件通知（可选）────────────────────
# 在 https://resend.com/api-keys 创建 API Key
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="ScamHawk <notifications@scamhawk.com>"  # 发件人地址（需验证域名）

# ── Vercel Cron 安全密钥 ──────────────────────
# Vercel Cron 会用 Authorization: Bearer <此值> 调用 /api/cron/watch
CRON_SECRET="generate-a-long-random-string"

# ── Upstash Redis（可选，推荐配置）─────────────
# 在 https://console.upstash.com 创建 Redis 数据库后获取
# 配置后启用 IP 级别限流，防止 API 被滥用
# 免费额度：10,000 命令/天，足够大多数项目使用
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# ── Chainabuse（可选，强烈建议配置）────────────
# 注册/登录 chainabuse.com 后在账号 API 页面生成（标准 Key 每月 10 次调用）；
# 更高额度请联系 APIsupport@certik.com。未配置时使用演示数据（界面会标注）。
CHAINABUSE_API_KEY=""

# ── 联盟推广链接（可选）───────────────────────
# 显示在价格页的硬件钱包推荐卡片
NEXT_PUBLIC_AFFILIATE_LEDGER_URL="https://shop.ledger.com/?r=xxxx"
NEXT_PUBLIC_AFFILIATE_TREZOR_URL="https://affil.trezor.io/xxxx"
